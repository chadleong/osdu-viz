      "data": {
        "Name": "Compositional",
        "ID": "Compositional",
        "ReservoirSimulationTypeTagCategoryIDs": "ReservoirSimulationFluidModel",
        "Description": "The Compositional Fluid Model is a more detailed approach to modeling reservoir fluids. It explicitly represents fluid composition using individual hydrocarbon components (e.g., methane, ethane, propane, etc.) and other components like CO2, N2, and water. This model accounts for changes in fluid composition and phase behavior during production, injection, and depletion. Includes thermodynamics-based Equations-of-State with full composition modeling.",
        "Code": "Compositional",
        "AttributionAuthority": "OSDU",
        "AttributionRevision": "evergreen",
        "Source": "Workbook ReferenceValues/Published/ReservoirSimulationTypeTag.1.xlsx; commit SHA 5c693079.",
        "CommitDate": "2025-11-11T04:54:42+00:00"
      }
    },
