      "data": {
        "Name": "Black Oil",
        "ID": "BlackOil",
        "ReservoirSimulationTypeTagCategoryIDs": "ReservoirSimulationFluidModel",
        "Description": "The Black Oil Fluid Model is a simplified approach to modeling reservoir fluids, commonly used for reservoirs containing primarily oil and associated gas and works well when fluid compositions change relatively little during production. This model assumes that oil, gas, and water exist as distinct phases, each described by a few key properties. Includes empirical correlations (GOR, Rs, etc.)",
        "Code": "BlackOil",
        "AttributionAuthority": "OSDU",
        "AttributionRevision": "evergreen",
        "Source": "Workbook ReferenceValues/Published/ReservoirSimulationTypeTag.1.xlsx; commit SHA 5c693079.",
        "CommitDate": "2025-11-11T04:54:42+00:00"
      }
    },
