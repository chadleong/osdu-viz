      "data": {
        "Name": "Thermal",
        "ID": "Thermal",
        "ReservoirSimulationTypeTagCategoryIDs": "ReservoirSimulationFluidModel",
        "Description": "The Thermal Compositional Fluid Model is a compositional model that also accounts for the effect of temperature on key fluid properties like viscosity, density, and phase equilibria. It is used for scenarios where heat transfer and thermal effects significantly influence fluid behavior, such as in heavy oil recovery, steam injection, or thermal enhanced oil recovery (EOR) processes. ",
        "Code": "Thermal",
        "AttributionAuthority": "OSDU",
        "AttributionRevision": "evergreen",
        "Source": "Workbook ReferenceValues/Published/ReservoirSimulationTypeTag.1.xlsx; commit SHA 5c693079.",
