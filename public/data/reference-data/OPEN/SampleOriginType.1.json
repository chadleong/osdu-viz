      "data": {
        "Name": "Original As-Acquired",
        "ID": "OriginalAsAcquired",
        "Description": "Indicates that the sample/specimen is in the form in which it was first acquired from a wellbore, site, or other facility, before any subsampling, derivation, or combination processes produced samples from this one. For example, this indicator would distinguish the sample of full-length whole core as-acquired (usually 9 metres long), from three 1-metre samples, which are sections of whole core that got subsampled from that full-length whole core.",
        "Code": "OriginalAsAcquired",
        "AttributionAuthority": "OSDU",
