      "data": {
        "Name": "Derived",
        "ID": "Derived",
        "Description": "A derived sample/specimen is one that results from a process applied to a parent sample that causes chemical change, where the output is chemically different from the input, such as \"flashing\" gas or oil. (Contrast with \"SubSampled\" and \"Combined\".)",
        "Code": "Derived",
