      "data": {
        "Name": "Synthetic",
        "ID": "Synthetic",
        "Description": "A synthetic fluid sample is artificially created in a laboratory by mixing known individual components (such as C1, C2, and C3 gases) to mimic a reservoir fluid's composition and properties. In contrast to a \"combined\"/\"re-combined\" fluid sample, a synthetic fluid sample does not require components to have physically originated from the relevant reservoir.",
        "Code": "Synthetic",
        "AttributionAuthority": "OSDU",
