      "data": {
        "Name": "SubSampled",
        "ID": "SubSampled",
        "Description": "Indicates that a sample is a smaller portion of a larger parent sample, extracted from the parent through a sub-sampling process that does not involve chemical change. (Contrast with \"Derived\".) For rock, examples include a core puck cut from a whole core, or an oil sample extracted from a core plug, even if the subsample does not have the same representative composition or lithology as the parent. For fluids, the subsample would exactly represent the parent (i.e., an aliquot).",
        "Code": "SubSampled",
        "AttributionAuthority": "OSDU",
        "AttributionRevision": "evergreen",
        "Source": "Workbook ReferenceValues/Published/SampleOriginType.1.xlsx; commit SHA 0d5b6d39.",
        "CommitDate": "2025-10-03T03:51:05+00:00"
      }
