      "data": {
        "Name": "Compositional.ComponentSolubilityInWaterTable",
        "ID": "Compositional.ComponentSolubilityInWaterTable",
        "Description": "Using the function for modeling component solubility in the aqueous phase as a table, where discrete solubility values (e.g., gas-water ratio values) at specific pressures and/or temperatures are explicitly provided.",
        "Code": "Compositional.ComponentSolubilityInWaterTable",
        "AttributionAuthority": "OSDU",
        "AttributionRevision": "evergreen",
        "(COMPANY: insert comment)": "Description Hussein found: \"Component solubility in the aqueous phase This option (also known as 'component solubility in water' and abbreviated to CSIW) enables the simulation of a three-phase equilibrium of aqueous, liquid, and vapor phases for non-thermal and thermal compositional models. You can use this functionality to simulate CO2 storage in saline aquifers or depleted reservoirs. When combined with solids and reactions, the impact of processes such as mineralization and salt precipitation can also be included in the simulation. If a CSIW case has more than one water-soluble hydrocarbon component, it is assumed that the aqueous solubility of the hydrocarbon component is not affected by the existence of other hydrocarbon components in the aqueous phase.\"",
        "Source": "Workbook ReferenceValues/Published/FluidModelPropertyFormulationMethod.1.xlsx; commit SHA 5c693079.",
        "CommitDate": "2025-11-11T04:54:42+00:00"
      }
    },
